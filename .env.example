# Copy to .env.local. This file contains no credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PORT=8765
# Keep 127.0.0.1 for a personal local workspace.
HOST=127.0.0.1
# Required when HOST is not a loopback address. Use a long random value.
APP_ACCESS_TOKEN=
